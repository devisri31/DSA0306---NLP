import nltk
import re
from nltk.tokenize import wordpunct_tokenize

patterns = [
    (r'.*ing$', 'VBG'),
    (r'.*ed$', 'VBD'),
    (r'.*es$', 'VBZ'),
    (r'.*ould$', 'MD'),
    (r'.*s$', 'NNS'),
    (r'.*ly$', 'RB'),
    (r'.*able$', 'JJ'),
    (r'.*ful$', 'JJ'),
    (r'.*ness$', 'NN'),
    (r'^-?[0-9]+(\.[0-9]+)?$', 'CD'),
    (r'.*', 'NN')
]

regexp_tagger = nltk.RegexpTagger(patterns)

sentence = "The boys are quickly running towards beautiful cars"
words = wordpunct_tokenize(sentence)
tagged = regexp_tagger.tag(words)

print("Rule-based POS Tagger")
print("Word\t\tPOS Tag\t\tRule")
print("-" * 50)

for word, tag in tagged:
    rule = "Default NN"
    for pat, t in patterns:
        if re.match(pat, word):
            if t == tag:
                rule = f"Pattern: {pat} -> {t}"
                break
    print(f"{word}\t\t{tag}\t\t{rule}")

print("\n" + "-"*50)
user_sentence = input("\nEnter a sentence: ")
words2 = wordpunct_tokenize(user_sentence)
tagged2 = regexp_tagger.tag(words2)

print("\nWord\t\tPOS Tag")
print("-" * 30)
for word, tag in tagged2:
    print(f"{word}\t\t{tag}")
