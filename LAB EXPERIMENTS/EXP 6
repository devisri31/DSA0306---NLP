import random
from collections import defaultdict

text = "i love nlp and i love python and i love coding"

words = text.split()

# Create Bigram Model
bigrams = defaultdict(list)
for i in range(len(words)-1):
    bigrams[words[i]].append(words[i+1])

print("Bigram Model:")
for key, value in bigrams.items():
    print(f"{key} -> {value}")

# Generate text
start_word = "i"
generated = [start_word]
current = start_word

for _ in range(10):
    if current in bigrams:
        next_word = random.choice(bigrams[current])
        generated.append(next_word)
        current = next_word
    else:
        break

print("\nGenerated Text:")
print(" ".join(generated))

w = input("\nEnter starting word: ")
if w in bigrams:
    print(f"Next possible words: {bigrams[w]}")
else:
    print("Word not in model")
