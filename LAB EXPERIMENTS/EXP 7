import nltk
nltk.download('averaged_perceptron_tagger_eng')

from nltk.tokenize import wordpunct_tokenize

text = "The boys are running and the girl is writing a letter in Chennai"

words = wordpunct_tokenize(text)
pos_tags = nltk.pos_tag(words)

print("Word\t\tPOS Tag")
print("-" * 30)
for word, tag in pos_tags:
    print(f"{word}\t\t{tag}")

sentence = input("\nEnter a sentence: ")
words2 = wordpunct_tokenize(sentence)
tags2 = nltk.pos_tag(words2)

print("\nWord\t\tPOS Tag")
print("-" * 30)
for word, tag in tags2:
    print(f"{word}\t\t{tag}")
