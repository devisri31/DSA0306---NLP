import re
from nltk.tokenize import wordpunct_tokenize
from nltk.tag import RegexpTagger, UnigramTagger
from nltk.corpus import treebank
import nltk

nltk.download('treebank')

train_data = treebank.tagged_sents()[:2000]

initial_patterns = [
    (r'.*ing$', 'VBG'),
    (r'.*ed$', 'VBD'),
    (r'.*es$', 'VBZ'),
    (r'.*ould$', 'MD'),
    (r'.*s$', 'NNS'),
    (r'.*ly$', 'RB'),
    (r'.*able$', 'JJ'),
    (r'.*', 'NN')
]

initial_tagger = RegexpTagger(initial_patterns)

def apply_transformation_rules(tagged_sentence):
    transformed = []
    for i, (word, tag) in enumerate(tagged_sentence):
        new_tag = tag

        if word.lower() in ['the', 'a', 'an']:
            new_tag = 'DT'
        elif word.lower() in ['is', 'am', 'are', 'was', 'were']:
            new_tag = 'VBZ' if word.lower() in ['is', 'am'] else 'VBP'
        elif i > 0 and tagged_sentence[i-1][1] == 'DT':
            if new_tag.startswith('VB'):
                new_tag = 'NN'
        elif word[0].isupper() and i!= 0:
            new_tag = 'NNP'
        elif re.match(r'^-?[0-9]+', word):
            new_tag = 'CD'

        transformed.append((word, new_tag))
    return transformed

sentence = "The boys are quickly running towards beautiful cars in Chennai"
words = wordpunct_tokenize(sentence)

initial_tags = initial_tagger.tag(words)

print("Initial Tagging (Regex):")
print("-" * 30)
for w, t in initial_tags:
    print(f"{w}\t\t{t}")

final_tags = apply_transformation_rules(initial_tags)

print("\nAfter Transformation Rules:")
print("-" * 30)
for w, t in final_tags:
    print(f"{w}\t\t{t}")

print("\n" + "-"*50)
user_sentence = input("\nEnter a sentence: ")
words2 = wordpunct_tokenize(user_sentence)
initial2 = initial_tagger.tag(words2)
final2 = apply_transformation_rules(initial2)

print("\nWord\t\tInitial\t\tFinal")
print("-" * 50)
for (w1, t1), (w2, t2) in zip(initial2, final2):
    print(f"{w1}\t\t{t1}\t\t{t2}")
